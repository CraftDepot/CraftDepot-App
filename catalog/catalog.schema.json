{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://craftdepot.github.io/CraftDepot-App/catalog.schema.json",
  "title": "CraftDepot catalog",
  "description": "The content config read by the CraftDepot website and polled by the CraftDepot launcher.",
  "type": "object",
  "required": ["schema", "name", "updated", "launcher", "categories", "apps"],
  "properties": {
    "$schema": { "type": "string" },
    "schema": {
      "const": 1,
      "description": "Format version. Bump only for breaking changes; launchers refuse a newer major version."
    },
    "name": { "type": "string" },
    "tagline": { "type": "string" },
    "updated": { "$ref": "#/$defs/date", "description": "When this file last changed." },
    "refresh_hours": {
      "type": "integer",
      "minimum": 1,
      "maximum": 168,
      "default": 6,
      "description": "How often launchers re-check this file."
    },
    "launcher": {
      "type": "object",
      "required": ["version", "repo"],
      "properties": {
        "version": { "type": "string", "description": "Newest launcher release. Older launchers show an update banner." },
        "repo": { "$ref": "#/$defs/repo" }
      },
      "additionalProperties": false
    },
    "categories": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "name": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "featured": {
      "type": "array",
      "description": "Added when publishing, from featured.json: app ids to feature, in order. Don't set it in catalog.json.",
      "items": { "$ref": "#/$defs/id" }
    },
    "notices": {
      "type": "array",
      "description": "Announcements shown in the launcher until dismissed.",
      "items": {
        "type": "object",
        "required": ["id", "title"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "title": { "type": "string" },
          "body": { "type": "string" },
          "url": { "type": "string", "pattern": "^https://" }
        },
        "additionalProperties": false
      }
    },
    "apps": {
      "type": "array",
      "items": { "$ref": "#/$defs/app" }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,39}$" },
    "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "repo": { "type": "string", "pattern": "^[A-Za-z0-9-]+/[A-Za-z0-9._-]+$", "description": "GitHub owner/name." },
    "platform": {
      "enum": ["windows-x86_64", "windows-aarch64", "macos-x86_64", "macos-aarch64", "linux-x86_64", "linux-aarch64"]
    },
    "asset": {
      "description": "A file-name pattern in the app's latest GitHub release (`*` matches anything). The install method is guessed from the extension unless given.",
      "oneOf": [
        { "type": "string", "minLength": 1 },
        {
          "type": "object",
          "required": ["file"],
          "properties": {
            "file": { "type": "string", "minLength": 1 },
            "method": {
              "enum": ["archive", "installer", "portable"],
              "description": "archive: unpack into the launcher's apps folder. installer: hand to the system installer. portable: a single runnable file."
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "app": {
      "type": "object",
      "required": ["id", "name", "replaces", "category", "tagline", "repo", "assets"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "type": "string" },
        "replaces": { "type": "array", "minItems": 1, "items": { "type": "string" }, "description": "The well-known software this is a Rust rewrite of." },
        "category": { "$ref": "#/$defs/id", "description": "One of the ids in `categories`." },
        "kind": {
          "enum": ["gui", "tui", "cli"],
          "description": "Optional, gui by default. gui: opens a window. tui: opens in a terminal. cli: a command to use from a terminal."
        },
        "tagline": { "type": "string" },
        "description": { "type": "string" },
        "repo": { "$ref": "#/$defs/repo" },
        "homepage": { "type": "string", "pattern": "^https://" },
        "license": { "type": "string", "description": "Optional: read from the GitHub repository when left out." },
        "color": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$", "description": "Optional tile colour, used when there is no icon; one is picked from the id when left out." },
        "icon": { "type": "string", "pattern": "^https://", "description": "A square PNG or JPEG, ideally 128–256 px." },
        "added": { "$ref": "#/$defs/date", "description": "Optional: filled in when publishing, from the day the entry was merged." },
        "assets": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": { "$ref": "#/$defs/platform" },
          "additionalProperties": { "$ref": "#/$defs/asset" }
        },
        "bin": {
          "type": "array",
          "items": { "type": "string", "pattern": "^[A-Za-z0-9._-]+$" },
          "description": "Executable names inside an archive (without .exe). The first one is what Open runs."
        },
        "launch": {
          "type": "object",
          "description": "Where a system installer puts the app, used to detect and open it. %VAR% and ~ are expanded.",
          "properties": {
            "windows": { "type": "string" },
            "macos": { "type": "string" },
            "linux": { "type": "string" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  }
}
